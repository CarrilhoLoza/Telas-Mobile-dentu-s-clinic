# Copie este arquivo para .env e ajuste os valores da sua máquina.
# O prefixo EXPO_PUBLIC_ é obrigatório: sem ele o Expo não injeta a variável
# no aplicativo. Esses valores ficam embutidos no bundle, então não coloque
# segredo aqui.

# Endereço da API.
#   Celular físico:    http://IP_DA_SUA_MAQUINA:5081/api
#   Emulador Android:  http://10.0.2.2:5081/api
EXPO_PUBLIC_API_BASE_URL=http://IP_DA_SUA_MAQUINA:5081/api

# true liga os dados falsos na tela de consultas, para demonstrar o app sem a API no ar.
EXPO_PUBLIC_USE_MOCK=false
